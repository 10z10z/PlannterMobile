# Copy to `.env` and fill in from your own Supabase project
# (Project Settings -> API). Both are prefixed EXPO_PUBLIC_ because they are
# read on the device: the anon key is meant to be public, and every table it
# can reach is guarded by row-level security rather than by the key itself.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
